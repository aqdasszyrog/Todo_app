# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Same page, "Secret keys". Server-only, never prefix with NEXT_PUBLIC_.
# Used to record a user's plan once Stripe confirms their payment.
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe Dashboard → Developers → API keys (use test mode keys while developing)
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard → Product catalogue → Premium → the recurring price's ID
STRIPE_PREMIUM_PRICE_ID=price_...
# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# (locally: printed by `stripe listen`, see README)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional, development only: other devices allowed to use `npm run dev`,
# comma-separated, e.g. a phone on the same Wi-Fi (find your IP: hostname -I)
# DEV_ORIGINS=192.168.1.20
